include(CMakeFindDependencyMacro)

# QuantLibObjects links the upstream QuantLib::QuantLib and ObjectHandler::ohlib
# imported targets, so a downstream standalone build that consumes QuantLibAddin
# via find_package(QuantLibAddin CONFIG) must re-find those upstream packages.
find_dependency(QuantLib CONFIG)
find_dependency(ObjectHandler CONFIG)

# NOTE: QuantExt::QuantExt is linked into QuantLibObjects only in the integrated
# (root) build, where it is supplied by the nested ORE submodule via
# cmake/quantext.cmake.  That link is guarded by if(TARGET QuantExt::QuantExt),
# so the standalone/exported target does not reference QuantExt and therefore no
# find_dependency(QuantExt) is required here.  When ORE gains an installable
# package config, add the corresponding find_dependency() call.

include("${CMAKE_CURRENT_LIST_DIR}/QuantLibAddinTargets.cmake")
