<Category name='quantext'>
	<description>Functions to construct and use QuantExt FX indexes, FX-linked cashflows and cross-currency swaps.</description>
	<displayName>QuantExt</displayName>
	<xlFunctionWizardCategory>QuantLib - Financial</xlFunctionWizardCategory>
	<serializationIncludes>
		<include>qlo/quantext.hpp</include>
		<include>qlo/quote.hpp</include>
		<include>qlo/yieldtermstructures.hpp</include>
		<include>qle/indexes/fxindex.hpp</include>
	</serializationIncludes>
	<addinIncludes>
		<include>qlo/quantext.hpp</include>
		<include>qlo/quote.hpp</include>
		<include>qlo/yieldtermstructures.hpp</include>
	</addinIncludes>
	<copyright>
		Copyright (C) 2026
	</copyright>
	<Functions>

		<Constructor name='qlFxIndex'>
			<libraryFunction>FxIndex</libraryFunction>
			<SupportedPlatforms>
				<SupportedPlatform name='Excel'/>
				<SupportedPlatform name='Cpp'/>
			</SupportedPlatforms>
			<processorName>IndexProcessor</processorName>
			<ParameterList>
				<Parameters>
					<Parameter name='FamilyName' exampleValue='ECB'>
						<type>string</type>
						<tensorRank>scalar</tensorRank>
						<description>index family name (e.g. ECB).</description>
					</Parameter>
					<Parameter name='FixingDays' exampleValue='2'>
						<type>QuantLib::Natural</type>
						<tensorRank>scalar</tensorRank>
						<description>fixing days (e.g. 2).</description>
					</Parameter>
					<Parameter name='SourceCurrency' exampleValue='EUR'>
						<type>QuantLib::Currency</type>
						<tensorRank>scalar</tensorRank>
						<description>source currency (e.g. EUR); the index value is units of target per unit of source.</description>
					</Parameter>
					<Parameter name='TargetCurrency' exampleValue='USD'>
						<type>QuantLib::Currency</type>
						<tensorRank>scalar</tensorRank>
						<description>target currency (e.g. USD).</description>
					</Parameter>
					<Parameter name='FixingCalendar' exampleValue='TARGET'>
						<type>QuantLib::Calendar</type>
						<tensorRank>scalar</tensorRank>
						<description>fixing calendar (e.g. TARGET).</description>
					</Parameter>
					<Parameter name='FxSpot' exampleValue='EURUSD'>
						<type>QuantLib::Quote</type>
						<superType>libToHandle</superType>
						<tensorRank>scalar</tensorRank>
						<description>FX spot quote (target per unit of source, immediate settlement).</description>
					</Parameter>
					<Parameter name='SourceYieldCurve' exampleValue='EURYC' default='""'>
						<type>QuantLib::YieldTermStructure</type>
						<superType>libToHandle</superType>
						<tensorRank>scalar</tensorRank>
						<description>source currency discount curve used to forecast fixings.</description>
					</Parameter>
					<Parameter name='TargetYieldCurve' exampleValue='USDYC' default='""'>
						<type>QuantLib::YieldTermStructure</type>
						<superType>libToHandle</superType>
						<tensorRank>scalar</tensorRank>
						<description>target currency discount curve used to forecast fixings.</description>
					</Parameter>
					<Parameter name='FixingTriangulation' exampleValue='TRUE' default='true'>
						<type>bool</type>
						<tensorRank>scalar</tensorRank>
						<description>TRUE to allow fixings to be derived by inversion/triangulation of other FX index fixings.</description>
					</Parameter>
				</Parameters>
			</ParameterList>
		</Constructor>

	</Functions>
</Category>
